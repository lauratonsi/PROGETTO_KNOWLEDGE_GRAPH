@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix clv:  <https://w3id.org/italia/onto/CLV/> .
@prefix cpv:  <https://w3id.org/italia/onto/CPV/> .
@prefix ex:   <https://w3id.org/bologna/ontology#> .

# ── Ontology ──────────────────────────────────────────────────────────────────

<https://w3id.org/bologna/ontology>
    a owl:Ontology ;
    rdfs:label "Ontologia Toponomastica di Bologna"@it ;
    rdfs:label "Bologna Street Toponymy Ontology"@en ;
    rdfs:comment "Knowledge Graph per l'analisi del divario di genere nella toponomastica di Bologna. Modella 1.131 strade intitolate a persone (Male o Female) su 1.960 censite. Solo 66 (5,8%) sono dedicate a donne — un rapporto di 1 a 16 rispetto agli uomini. Il KG integra dati Open Data del Comune, classificazione LLM, arricchimento biografico via Wikidata e 34 proposte di nuove intitolazioni in un file separato (proposte_KG.ttl)."@it ;
    rdfs:comment "Knowledge Graph for analysing the gender gap in Bologna's street toponymy. Models 1,131 streets dedicated to people (Male or Female) out of 1,960 surveyed. Only 66 (5.8%) are dedicated to women — a 1-to-16 ratio against men. The KG combines Open Data from the Municipality of Bologna, LLM-based gender classification, Wikidata biographical enrichment, and 34 proposals for new dedications stored in a separate file (proposte_KG.ttl)."@en ;
    <http://purl.org/dc/terms/title> "Gender Gap nella Toponomastica di Bologna — Knowledge Graph"@it ;
    <http://purl.org/dc/terms/title> "Gender Gap in Bologna Street Toponymy — Knowledge Graph"@en ;
    <http://purl.org/dc/terms/description> "Il KG è composto da 16.222 triple RDF. La pipeline: (1) Open Data CSV del Comune → classificazione LLM (Claude, ChatGPT, Gemini, DeepSeek, Copilot) → correzione sistematica con equita.py → generazione Turtle con genera_ttl.py; (2) arricchimento biografico via API Wikidata (P106, P569, P570) su 1.129 persone, copertura 88,7%; (3) 34 proposte di nuove intitolazioni in proposte_KG.ttl (file separato). Progetto universitario GEPID 2024–25, Università di Bologna."@it ;
    <http://purl.org/dc/terms/description> "The KG consists of 16,222 RDF triples. Pipeline: (1) Municipality CSV Open Data → LLM classification (Claude, ChatGPT, Gemini, DeepSeek, Copilot) → systematic correction with equita.py → Turtle generation with genera_ttl.py; (2) biographical enrichment via Wikidata API (P106, P569, P570) for 1,129 people, 88.7% coverage; (3) 34 new street dedication proposals in proposte_KG.ttl (separate file). GEPID university project 2026, University of Bologna."@en ;
    <http://purl.org/dc/terms/creator> "Susanna Cioni" ;
    <http://purl.org/dc/terms/creator> "Laura Tonsi" ;
    <http://purl.org/dc/terms/publisher> "Università di Bologna — Corso GEPID 2026" ;
    <http://purl.org/dc/terms/date> "2026" ;
    <http://purl.org/dc/terms/source> <https://opendata.comune.bologna.it/> ;
    <http://purl.org/dc/terms/source> <https://www.wikidata.org/> ;
    <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
    <http://purl.org/dc/terms/rights> "CC BY 4.0 — Attribuzione richiesta" ;
    <http://www.w3.org/2002/07/owl#versionInfo> "1.2 — conformità CLV-AP_IT v1.0 (clv:StreetToponym, clv:officialStreetName, ex:isDedicatedTo)" ;
    <http://xmlns.com/foaf/0.1/homepage> <https://lauratonsi.github.io/PROGETTO_KNOWLEDGE_GRAPH/> ;
    <http://xmlns.com/foaf/0.1/page> <https://github.com/lauratonsi/PROGETTO_KNOWLEDGE_GRAPH> .

# ── Classes ───────────────────────────────────────────────────────────────────

clv:StreetToponym
    a owl:Class ;
    rdfs:label "Toponimo Stradale"@it ;
    rdfs:label "Street Toponym"@en ;
    rdfs:comment "Nome ufficiale assegnato a un arco stradale del grafo viario bolognese (via, piazza, viale, passaggio, largo, rotonda, parco, giardino, ecc.). Ogni istanza corrisponde a un CODVIA univoco degli Open Data comunali. Le istanze possono avere proprietà di arricchimento: quartiere, coordinate geografiche, data di istituzione, tipologia luogo. Conforme a CLV-AP_IT v1.0 (verificato su schema.gov.it/lodview/onto/CLV)."@it .

cpv:Person
    a owl:Class ;
    rdfs:label "Persona"@it ;
    rdfs:label "Person"@en ;
    rdfs:comment "Persona storica a cui è intitolata almeno una strada bolognese, oppure candidatura proposta dal gruppo di ricerca per una futura intitolazione. Classificata come Male o Female. Le istanze Female includono dati biografici da Wikidata (professione, nascita, morte). Le istanze proposte hanno ex:statoProposta 'attiva' o 'futura' e sono contenute nel file separato proposte_KG.ttl."@it .

# ── Object Property ───────────────────────────────────────────────────────────

ex:isDedicatedTo
    a owl:ObjectProperty ;
    rdfs:label "è dedicata a"@it ;
    rdfs:label "is dedicated to"@en ;
    rdfs:domain clv:StreetToponym ;
    rdfs:range  cpv:Person ;
    rdfs:comment "PROPRIETÀ CUSTOM Bologna (estensione al namespace ex:). CLV-AP_IT v1.0 non definisce alcuna proprietà per la relazione persona-luogo (verifica: schema.gov.it/lodview/onto/CLV). Collega un toponimo stradale alla persona a cui è intitolato. Presente solo per strade di genere Male o Female — i Toponimi senza riferimento a persona non hanno questo collegamento."@it .

# ── Datatype Properties (rilevanti per l'analisi) ─────────────────────────────

clv:officialStreetName
    a owl:DatatypeProperty ;
    rdfs:label "nome ufficiale della strada"@it ;
    rdfs:label "official street name"@en ;
    rdfs:domain clv:StreetToponym ;
    rdfs:range  xsd:string ;
    rdfs:comment "Nome ufficiale del toponimo stradale. Conforme a CLV-AP_IT v1.0."@it .

cpv:hasSex
    a owl:ObjectProperty ;
    rdfs:label "sesso biologico"@it ;
    rdfs:label "sex"@en ;
    rdfs:domain cpv:Person ;
    rdfs:range  <https://w3id.org/italia/onto/CPV/Sex> ;
    rdfs:comment "Collega la persona a un'istanza del vocabolario controllato CPV-AP_IT: sex/M o sex/F. NOTA METODOLOGICA: CPV v0.8 (marzo 2023) ha introdotto anche cpv:hasGender, distinto da cpv:hasSex, per modellare l'identità di genere socio-culturale. Abbiamo scelto cpv:hasSex perché il vocabolario controllato corrispondente per cpv:hasGender (classifications-for-people/gender) non è ancora pubblicato su schema.gov.it (risposta HTTP 404 verificata il 4 giugno 2026). Usare cpv:hasGender senza vocabolario controllato renderebbe il KG non dereferenziabile. La scelta sarà rivista quando Ontopia pubblicherà il vocabolario."@it .

cpv:fullName
    a owl:DatatypeProperty ;
    rdfs:label "nome completo"@it ;
    rdfs:label "full name"@en ;
    rdfs:domain cpv:Person ;
    rdfs:range  rdfs:Literal .

ex:professione
    a owl:DatatypeProperty ;
    rdfs:label "professione"@it ;
    rdfs:label "occupation"@en ;
    rdfs:domain cpv:Person ;
    rdfs:range  xsd:string ;
    rdfs:comment "Ricavata da Wikidata P106 o fonti archivistiche locali."@it .

ex:statoProposta
    a owl:DatatypeProperty ;
    rdfs:label "stato della proposta"@it ;
    rdfs:label "proposal status"@en ;
    rdfs:domain cpv:Person ;
    rdfs:range  xsd:string ;
    rdfs:comment "Valori: 'attiva' (decesso >10 anni) o 'futura' (decesso <10 anni o persona in vita). Proprietà presente solo nelle istanze di proposte_KG.ttl, non nel KG principale."@it .

# ── Datatype Properties — metadati biografici ─────────────────────────────────

ex:dataNascita
    a owl:DatatypeProperty ;
    rdfs:label "data di nascita"@it ;
    rdfs:label "date of birth"@en ;
    rdfs:domain cpv:Person ;
    rdfs:range  xsd:string ;
    rdfs:comment "Wikidata P569. Formato testuale (es. '27 gennaio 1756')."@it .

ex:luogoNascita
    a owl:DatatypeProperty ;
    rdfs:label "luogo di nascita"@it ;
    rdfs:label "place of birth"@en ;
    rdfs:domain cpv:Person ;
    rdfs:range  xsd:string ;
    rdfs:comment "Wikidata P19."@it .

ex:dataMorte
    a owl:DatatypeProperty ;
    rdfs:label "data di morte"@it ;
    rdfs:label "date of death"@en ;
    rdfs:domain cpv:Person ;
    rdfs:range  xsd:string ;
    rdfs:comment "Wikidata P570."@it .

ex:luogoMorte
    a owl:DatatypeProperty ;
    rdfs:label "luogo di morte"@it ;
    rdfs:label "place of death"@en ;
    rdfs:domain cpv:Person ;
    rdfs:range  xsd:string ;
    rdfs:comment "Wikidata P20."@it .

# ── Datatype Properties — arricchimento topografico (strade) ──────────────────

ex:quartiere
    a owl:DatatypeProperty ;
    rdfs:label "quartiere"@it ;
    rdfs:label "district"@en ;
    rdfs:domain clv:StreetToponym ;
    rdfs:range  xsd:string ;
    rdfs:comment "Nome del quartiere bolognese in cui ricade la strada."@it .

ex:geoPoint
    a owl:DatatypeProperty ;
    rdfs:label "geo point"@it ;
    rdfs:label "geo point"@en ;
    rdfs:domain clv:StreetToponym ;
    rdfs:range  xsd:string ;
    rdfs:comment "Coordinate WGS84 del centroide della strada (lat, lon), estratte dal dataset Open Data Comune di Bologna."@it .

ex:dataIstituzione
    a owl:DatatypeProperty ;
    rdfs:label "data di istituzione"@it ;
    rdfs:label "institution date"@en ;
    rdfs:domain clv:StreetToponym ;
    rdfs:range  xsd:string ;
    rdfs:comment "Data di istituzione ufficiale dell'intitolazione, formato ISO 8601 (es. '1991-10-21')."@it .

ex:tipologiaLuogo
    a owl:DatatypeProperty ;
    rdfs:label "tipologia del luogo"@it ;
    rdfs:label "place type"@en ;
    rdfs:domain clv:StreetToponym ;
    rdfs:range  xsd:string ;
    rdfs:comment "Tipo di luogo toponomastico (Via, Largo, Piazza, Passaggio, Rotonda, Parco, Giardino, ecc.). Presente solo per i luoghi dedicati a donne, estratto dal dataset 'Aree verdi e vie dedicate alle donne'."@it .

# ── Datatype Properties — arricchimento semantico (persone) ──────────────────

ex:macroCategoriaOccupazionale
    a owl:DatatypeProperty ;
    rdfs:label "macro categoria occupazionale"@it ;
    rdfs:label "occupational macro category"@en ;
    rdfs:domain cpv:Person ;
    rdfs:range  xsd:string ;
    rdfs:comment "PROPRIETÀ CUSTOM Bologna — tassonomia storico-culturale non standard. NOTA METODOLOGICA: Ontopia/schema.gov.it non fornisce alcuna classificazione per professioni o occupazioni (verificato il 4 giugno 2026: CPV ha 23 object property e 16 data property, nessuna relativa a professione; VocabolariControllati/classifications-for-people include solo education-level, marital-status, parental-relationship, person-title, registry-office types, sex). La CP 2011 ISTAT (adattamento italiano di ISCO-08) modella occupazioni contemporanee e non si applica a figure storiche (es. 'Patriota risorgimentale', 'Pittrice fiamminga'). Tassonomia Bologna-specifica con 13 valori: Arte visiva e architettura · Filosofia, storia e accademia · Istruzione ed educazione · Letteratura e giornalismo · Musica, teatro e cinema · Patrioti, militari ed esploratori · Politica e diritto · Religione · Resistenza e antifascismo · Scienze e medicina · Sindacalismo e attivismo civile · Sport · Altro / istituzionale."@it .

ex:datiAnagrafici
    a owl:DatatypeProperty ;
    rdfs:label "dati anagrafici"@it ;
    rdfs:label "biographical data"@en ;
    rdfs:domain cpv:Person ;
    rdfs:range  xsd:string ;
    rdfs:comment "Stringa sintetica con luogo e anno di nascita e morte (es. 'Bologna, 1711 - Parigi, 1782'). Presente solo per le donne, estratta dal dataset 'Aree verdi e vie dedicate alle donne'."@it .
