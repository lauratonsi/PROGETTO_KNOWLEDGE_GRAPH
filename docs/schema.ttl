@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix clv:  <https://w3id.org/italia/onto/CLV/> .
@prefix cpv:  <https://w3id.org/italia/onto/CPV/> .
@prefix ex:   <https://w3id.org/bologna/ontology#> .

# ── Ontology ──────────────────────────────────────────────────────────────────

<https://w3id.org/bologna/ontology>
    a owl:Ontology ;
    rdfs:label "Ontologia Toponomastica di Bologna"@it ;
    rdfs:label "Bologna Street Toponymy Ontology"@en ;
    rdfs:comment "Ontologia per la classificazione di genere della toponomastica del Comune di Bologna. Riutilizza CLV e CPV (vocabolari controllati italiani) ed estende con proprietà custom per la gestione delle proposte di intitolazione."@it ;
    rdfs:comment "Ontology for gender classification of street toponymy in the Municipality of Bologna. Reuses CLV and CPV (Italian controlled vocabularies) and extends them with custom properties for managing naming proposals."@en ;
    <http://purl.org/dc/terms/title> "Gender Gap nella Toponomastica di Bologna — Knowledge Graph"@it ;
    <http://purl.org/dc/terms/title> "Gender Gap in Bologna Street Toponymy — Knowledge Graph"@en ;
    <http://purl.org/dc/terms/description> "Knowledge Graph RDF per analizzare il divario di genere nelle intitolazioni stradali del Comune di Bologna. Su 1.960 strade censite, solo 66 (5,8%) sono intitolate a donne. Il KG è costruito a partire dagli Open Data del Comune di Bologna, classificato con LLM e arricchito tramite Wikidata."@it ;
    <http://purl.org/dc/terms/creator> "Susanna Cioni" ;
    <http://purl.org/dc/terms/creator> "Laura Tonsi" ;
    <http://purl.org/dc/terms/publisher> "Università di Bologna — Corso GEPID 2024–25" ;
    <http://purl.org/dc/terms/date> "2026" ;
    <http://purl.org/dc/terms/source> <https://opendata.comune.bologna.it/> ;
    <http://purl.org/dc/terms/source> <https://www.wikidata.org/> ;
    <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
    <http://purl.org/dc/terms/rights> "CC BY 4.0 — Attribuzione richiesta" ;
    <http://www.w3.org/2002/07/owl#versionInfo> "1.1 — arricchimento topografico e semantico" ;
    <http://xmlns.com/foaf/0.1/homepage> <https://lauratonsi.github.io/PROGETTO_KNOWLEDGE_GRAPH/> ;
    <http://xmlns.com/foaf/0.1/page> <https://github.com/lauratonsi/PROGETTO_KNOWLEDGE_GRAPH> .

# ── Classes ───────────────────────────────────────────────────────────────────

clv:Street
    a owl:Class ;
    rdfs:label "Strada"@it ;
    rdfs:label "Street"@en ;
    rdfs:comment "Arco stradale del grafo viario del Comune di Bologna (via, piazza, viale, passaggio, largo, ecc.)."@it .

cpv:Person
    a owl:Class ;
    rdfs:label "Persona"@it ;
    rdfs:label "Person"@en ;
    rdfs:comment "Persona storica a cui è intitolata una strada, oppure candidatura proposta per una futura intitolazione."@it .

# ── Object Property ───────────────────────────────────────────────────────────

clv:isDedicatedTo
    a owl:ObjectProperty ;
    rdfs:label "è dedicata a"@it ;
    rdfs:label "is dedicated to"@en ;
    rdfs:domain clv:Street ;
    rdfs:range  cpv:Person ;
    rdfs:comment "Collega una strada alla persona a cui è intitolata (solo strade Male o Female)."@it .

# ── Datatype Properties (rilevanti per l'analisi) ─────────────────────────────

clv:hasStreetName
    a owl:DatatypeProperty ;
    rdfs:label "nome della strada"@it ;
    rdfs:label "street name"@en ;
    rdfs:domain clv:Street ;
    rdfs:range  xsd:string .

cpv:sex
    a owl:DatatypeProperty ;
    rdfs:label "classificazione di genere"@it ;
    rdfs:label "gender classification"@en ;
    rdfs:domain cpv:Person ;
    rdfs:range  xsd:string ;
    rdfs:comment "Valori: 'Male', 'Female', 'Toponimo'."@it .

ex:professione
    a owl:DatatypeProperty ;
    rdfs:label "professione"@it ;
    rdfs:label "occupation"@en ;
    rdfs:domain cpv:Person ;
    rdfs:range  xsd:string ;
    rdfs:comment "Ricavata da Wikidata P106 o fonti archivistiche locali."@it .

ex:proposta
    a owl:DatatypeProperty ;
    rdfs:label "proposta di intitolazione"@it ;
    rdfs:label "naming proposal"@en ;
    rdfs:domain cpv:Person ;
    rdfs:range  xsd:string ;
    rdfs:comment "Valore 'true' per le candidature proposte dal gruppo di ricerca."@it .

ex:statoProposta
    a owl:DatatypeProperty ;
    rdfs:label "stato della proposta"@it ;
    rdfs:label "proposal status"@en ;
    rdfs:domain cpv:Person ;
    rdfs:range  xsd:string ;
    rdfs:comment "Valori: 'attiva' (decesso >10 anni) o 'futura' (decesso <10 anni o persona in vita)."@it .

# ── Annotation Properties (identificatori) ────────────────────────────────────

cpv:fullName
    a owl:AnnotationProperty ;
    rdfs:label "nome completo"@it ;
    rdfs:label "full name"@en ;
    rdfs:domain cpv:Person .

# ── Datatype Properties — metadati biografici ─────────────────────────────────

ex:dataNascita
    a owl:DatatypeProperty ;
    rdfs:label "data di nascita"@it ;
    rdfs:label "date of birth"@en ;
    rdfs:domain cpv:Person ;
    rdfs:range  xsd:string ;
    rdfs:comment "Wikidata P569. Formato testuale (es. '27 gennaio 1756')."@it .

ex:luogoNascita
    a owl:DatatypeProperty ;
    rdfs:label "luogo di nascita"@it ;
    rdfs:label "place of birth"@en ;
    rdfs:domain cpv:Person ;
    rdfs:range  xsd:string ;
    rdfs:comment "Wikidata P19."@it .

ex:dataMorte
    a owl:DatatypeProperty ;
    rdfs:label "data di morte"@it ;
    rdfs:label "date of death"@en ;
    rdfs:domain cpv:Person ;
    rdfs:range  xsd:string ;
    rdfs:comment "Wikidata P570."@it .

ex:luogoMorte
    a owl:DatatypeProperty ;
    rdfs:label "luogo di morte"@it ;
    rdfs:label "place of death"@en ;
    rdfs:domain cpv:Person ;
    rdfs:range  xsd:string ;
    rdfs:comment "Wikidata P20."@it .

# ── Datatype Properties — arricchimento topografico (strade) ──────────────────

ex:quartiere
    a owl:DatatypeProperty ;
    rdfs:label "quartiere"@it ;
    rdfs:label "district"@en ;
    rdfs:domain clv:Street ;
    rdfs:range  xsd:string ;
    rdfs:comment "Nome del quartiere bolognese in cui ricade la strada."@it .

ex:geoPoint
    a owl:DatatypeProperty ;
    rdfs:label "geo point"@it ;
    rdfs:label "geo point"@en ;
    rdfs:domain clv:Street ;
    rdfs:range  xsd:string ;
    rdfs:comment "Coordinate WGS84 del centroide della strada (lat, lon), estratte dal dataset Open Data Comune di Bologna."@it .

ex:dataIstituzione
    a owl:DatatypeProperty ;
    rdfs:label "data di istituzione"@it ;
    rdfs:label "institution date"@en ;
    rdfs:domain clv:Street ;
    rdfs:range  xsd:string ;
    rdfs:comment "Data di istituzione ufficiale dell'intitolazione, formato ISO 8601 (es. '1991-10-21')."@it .

ex:tipologiaLuogo
    a owl:DatatypeProperty ;
    rdfs:label "tipologia del luogo"@it ;
    rdfs:label "place type"@en ;
    rdfs:domain clv:Street ;
    rdfs:range  xsd:string ;
    rdfs:comment "Tipo di luogo toponomastico (Via, Largo, Piazza, Passaggio, Rotonda, Parco, Giardino, ecc.). Presente solo per i luoghi dedicati a donne, estratto dal dataset 'Aree verdi e vie dedicate alle donne'."@it .

# ── Datatype Properties — arricchimento semantico (persone) ──────────────────

ex:macroCategoriaOccupazionale
    a owl:DatatypeProperty ;
    rdfs:label "macro categoria occupazionale"@it ;
    rdfs:label "occupational macro category"@en ;
    rdfs:domain cpv:Person ;
    rdfs:range  xsd:string ;
    rdfs:comment "Categoria semantica della professione, assegnata dal gruppo di ricerca tramite matching su parole chiave. Valori: 'Arte visiva e architettura', 'Filosofia, storia e accademia', 'Letteratura e giornalismo', 'Musica, teatro e cinema', 'Patrioti, militari ed esploratori', 'Politica e diritto', 'Religione', 'Scienze e medicina', 'Altro / istituzionale'."@it .

ex:datiAnagrafici
    a owl:DatatypeProperty ;
    rdfs:label "dati anagrafici"@it ;
    rdfs:label "biographical data"@en ;
    rdfs:domain cpv:Person ;
    rdfs:range  xsd:string ;
    rdfs:comment "Stringa sintetica con luogo e anno di nascita e morte (es. 'Bologna, 1711 - Parigi, 1782'). Presente solo per le donne, estratta dal dataset 'Aree verdi e vie dedicate alle donne'."@it .
